{
  "name": "dsh-web-search-crw",
  "version": "0.2.0",
  "description": "CRW (Firecrawl-compatible) search provider for the DeepSeek Harness web capability seam (ctx.web): registers a WebSearchProvider that calls CRW POST /v1/search, with a schema-driven Settings page on the dsh web Plugins page",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "JanisKroja",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "web-search",
    "search-provider",
    "crw",
    "firecrawl",
    "self-hosted"
  ],
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "install:dsh": "bash scripts/install-to-dsh.sh"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-web": "^0.2.0-rc.2"
  }
}
